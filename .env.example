# このファイルを .env にコピーして値を入れてください（.env は Git に入れないこと）

# HOPE の URL
MOODLE_URL=https://hope.fun.ac.jp

# HOPE のトークン（`hope-notifier token` を実行すると自動で書き込まれます）
MOODLE_TOKEN=

# Discord の Webhook URL（サーバー設定 → 連携サービス → ウェブフック で作成）
DISCORD_WEBHOOK_URL=

# 確認する間隔
POLL_INTERVAL=5m

# 締切の何時間前に通知するか（カンマ区切り）
REMIND_BEFORE=24h,1h

# 毎朝の「今日の締切」一覧を送る時刻（送らない場合は off）
DIGEST_TIME=07:00

# タイムゾーン
TZ_NAME=Asia/Tokyo

# 通知済みの記録を保存するファイル
STATE_FILE=state.json

# ---- リマインド Bot（使わない場合は空のまま） ----
# Discord Developer Portal で作った Bot のトークン
DISCORD_BOT_TOKEN=

# リマインドを受け付けるチャンネルの ID
REMIND_CHANNEL_ID=

# 予約を保存するファイル
REMINDERS_FILE=reminders.json

# 時間になったときにメンションする人（ユーザー名か ID をカンマ区切り。空なら依頼した本人）
REMIND_MENTION_USERS=
